{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
            }
        },
        {
            "name": "plain-debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "FW_PROFILE": "plain"
            }
        },
        {
            "name": "plain-release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "FW_PROFILE": "plain"
            }
        },
        {
            "name": "heater-debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "FW_PROFILE": "heater"
            }
        },
        {
            "name": "heater-release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "FW_PROFILE": "heater"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "plain-debug",
            "configurePreset": "plain-debug"
        },
        {
            "name": "plain-release",
            "configurePreset": "plain-release"
        },
        {
            "name": "heater-debug",
            "configurePreset": "heater-debug"
        },
        {
            "name": "heater-release",
            "configurePreset": "heater-release"
        }
    ]
}
